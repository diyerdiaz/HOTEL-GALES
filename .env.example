# Copia este archivo como .env y completa los valores.
# El archivo .env nunca se sube a GitHub (está en .gitignore).

# --- Seguridad ---
# Clave larga y aleatoria. Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# true solo si el sitio se sirve con HTTPS
COOKIE_SECURE=false
# Modo debug: SOLO en tu computador, nunca en producción
FLASK_DEBUG=0

# --- Base de datos (si se deja vacío se usa SQLite en instance/) ---
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=5432
DB_NAME=

# --- Administrador inicial ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Dirección pública del sitio (para los enlaces de los correos) ---
# Ejemplo: https://hotelgales.com
URL_PUBLICA=

# --- Correo saliente (recuperación de contraseña) ---
# Si MAIL_SERVER queda vacío no se envían correos y el enlace se escribe en el registro del servidor.
#
# Gmail:   MAIL_SERVER=smtp.gmail.com     MAIL_PORT=587  MAIL_USE_TLS=true
#          MAIL_PASSWORD debe ser una "contraseña de aplicación" (Cuenta de Google > Seguridad >
#          Verificación en 2 pasos > Contraseñas de aplicaciones), no la contraseña normal.
# Outlook: MAIL_SERVER=smtp.office365.com MAIL_PORT=587  MAIL_USE_TLS=true
# Brevo:   MAIL_SERVER=smtp-relay.brevo.com MAIL_PORT=587 MAIL_USE_TLS=true
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
# Dirección que aparece como remitente (si se deja vacía se usa MAIL_USERNAME)
MAIL_SENDER=
MAIL_SENDER_NAME=Hotel Gales

# --- Solo desarrollo: mostrar el enlace de recuperación en pantalla (nunca en producción) ---
MOSTRAR_TOKEN_RECUPERACION=false
